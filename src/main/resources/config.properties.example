db.url=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&connectTimeout=10
db.user=postgres.YOUR_PROJECT_REF
db.password=YOUR_DATABASE_PASSWORD_HERE
